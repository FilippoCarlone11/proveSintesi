digraph "register" {
label="register";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="_0_", color="black", fontcolor="black"];
n2 [ shape=octagon, label="Q", color="black", fontcolor="black"];
n3 [ shape=octagon, label="D", color="black", fontcolor="black"];
n4 [ shape=octagon, label="rst", color="black", fontcolor="black"];
n5 [ shape=octagon, label="clk", color="black", fontcolor="black"];
c8 [ shape=record, label="{{<p6> CLK|<p3> D|<p2> Q|<p7> RN}|_2_\nDFFRNQ_X1|{}}",  ];
c11 [ shape=record, label="{{<p9> I|<p10> ZN}|_1_\nINV_X1|{}}",  ];
n1:e -> c11:p10:w [color="black", fontcolor="black", label=""];
n1:e -> c8:p7:w [color="black", fontcolor="black", label=""];
n2:e -> c8:p2:w [color="black", fontcolor="black", label=""];
n3:e -> c8:p3:w [color="black", fontcolor="black", label=""];
n4:e -> c11:p9:w [color="black", fontcolor="black", label=""];
n5:e -> c8:p6:w [color="black", fontcolor="black", label=""];
}
